{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "StylovizNgAdd",
  "title": "Styloviz ng add",
  "type": "object",
  "properties": {
    "project": { "type": "string", "description": "The application to set up. Defaults to the first application in angular.json.", "$default": { "$source": "projectName" } },
