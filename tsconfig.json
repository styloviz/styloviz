        "./projects/password-strength/src/public-api.ts"
      ],
      "@styloviz/phone-input": [
        "./projects/phone-input/src/public-api.ts"
      ],
      "@styloviz/product-tour": [
        "./projects/product-tour-free/src/public-api.ts"
      ],
      "@styloviz/scroll-area": [
        "./projects/scroll-area/src/public-api.ts"
