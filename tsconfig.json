{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": [
      "ES2022",
      "dom",
      "dom.iterable"
    ],
    "skipLibCheck": true,
    "paths": {
      "@testing/*": [
        "./src/testing/*"
      ],
      "@styloviz/accordion": [
        "./projects/accordion-free/src/public-api.ts"
      ],
      "@styloviz/affix": [
        "./projects/affix/src/public-api.ts"
      ],
      "@styloviz/ai-insight-cards": [
        "./projects/ai-insight-cards/src/public-api.ts"
      ],
