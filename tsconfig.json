        "./projects/badge/src/public-api.ts"
      ],
      "@styloviz/barcode-1d": [
        "./projects/barcode-1d/src/public-api.ts"
      ],
      "@styloviz/breadcrumb": [
        "./projects/breadcrumb/src/public-api.ts"
