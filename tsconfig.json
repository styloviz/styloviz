      ],
      "@styloviz/citation-sources": [
        "./projects/citation-sources/src/public-api.ts"
      ],
      "@styloviz/code-block": [
        "./projects/code-block/src/public-api.ts"
      ],
      "@styloviz/commerce": [
        "./projects/commerce/src/public-api.ts"
      ],
      "@styloviz/core": [
        "./projects/core/src/public-api.ts"
      ],
      "@styloviz/data": [
        "./projects/data/src/public-api.ts"
      ],
      "@styloviz/data-table": [
        "./projects/data-table-free/src/public-api.ts"
      ],
      "@styloviz/display": [
        "./projects/display/src/public-api.ts"
      ],
      "@styloviz/empty-state": [
        "./projects/empty-state/src/public-api.ts"
