{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [],
    "paths": {
      "@styloviz/core": ["../../dist/@styloviz/core/types/styloviz-core.d.ts"],
      "@styloviz/icons": ["../../dist/@styloviz/icons/types/styloviz-icons.d.ts"],
      "@styloviz/kbd": ["../../dist/@styloviz/kbd/types/styloviz-kbd.d.ts"]
    }
  },
  "exclude": [
    "**/*.spec.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
