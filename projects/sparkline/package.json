    "directory": "projects/sparkline"
  },
  "bugs": {
    "url": "https://github.com/styloviz/community/discussions"
  },
  "peerDependencies": {
    "@angular/common": ">=21.0.0 <23.0.0",
    "@angular/core": ">=21.0.0 <23.0.0",
    "@styloviz/core": "^1.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
