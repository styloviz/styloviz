{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [],
    "paths": {
      "@styloviz/core": [
        "../../dist/@styloviz/core/types/styloviz-core.d.ts"
      ],
      "@styloviz/core/*": [
        "../../dist/@styloviz/core/types/styloviz-core-*.d.ts"
      ],
      "@styloviz/icons": [
        "../../dist/@styloviz/icons/types/styloviz-icons.d.ts"
      ],
      "@styloviz/icons/glyph/*": [
        "../../dist/@styloviz/icons/types/styloviz-icons.d.ts"
      ],
      "@styloviz/icons/registry": [
        "../../dist/@styloviz/icons/types/styloviz-icons.d.ts"
      ],
      "@styloviz/icons/core": ["../../dist/@styloviz/icons/types/styloviz-icons-core.d.ts"],
      "@styloviz/overlays": [
        "../../dist/@styloviz/overlays/types/styloviz-overlays.d.ts"
      ],
      "@styloviz/scroll-area": [
        "../../dist/@styloviz/scroll-area/types/styloviz-scroll-area.d.ts"
      ],
      "@styloviz/overlays/*": [
        "../../dist/@styloviz/overlays/types/styloviz-overlays-*.d.ts"
      ]
    }
  },
  "exclude": [
    "**/*.spec.ts"
  ]
}
